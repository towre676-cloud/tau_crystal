import Std

namespace CRO

/-- A factorization of the evaluated coboundary through mℤ obstructs gluing. -/
theorem modularObstruction {A : Type} (d : A → Int) (m r : Int)
    (annihilates : ∀ a, m ∣ d a) (separates : ¬ m ∣ r) :
    ¬ ∃ a, d a = r := by
  rintro ⟨a, ha⟩
  exact separates (ha ▸ annihilates a)

theorem rationalObstruction {A : Type} (d : A → Int) (r : Int)
    (annihilates : ∀ a, d a = 0) (separates : r ≠ 0) :
    ¬ ∃ a, d a = r := by
  rintro ⟨a, ha⟩
  exact separates (ha.symm.trans (annihilates a))

/-- A monodromy shear gives image generated by 4 on the first coordinate. -/
theorem shearHasOrderTwo :
    (¬ ∃ a : Int, 4 * a = 2) ∧ (∃ a : Int, 4 * a = 2 * 2) := by
  constructor
  · apply modularObstruction (fun a : Int => 4 * a) 4 2
    · intro a
      exact ⟨a, rfl⟩
    · decide
  · exact ⟨1, by decide⟩

#print axioms modularObstruction
#print axioms rationalObstruction
#print axioms shearHasOrderTwo

end CRO
