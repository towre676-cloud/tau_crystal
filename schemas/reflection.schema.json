{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReflectionCertificate",
  "type": "object",
  "properties": {
    "reflection_certificate": {
      "type":"object",
      "properties": {
        "forward":{"type":"object"},
        "reverse":{"type":"object"},
        "spectral_gap":{"type":"object"},
        "residue_diff":{"type":"number"},
        "within_tolerance":{"type":"boolean"},
        "positivity_claim":{"type":"string"}
      },
      "required":["forward","reverse","spectral_gap","residue_diff","within_tolerance","positivity_claim"]
    }
  },
  "required":["reflection_certificate"]
}
