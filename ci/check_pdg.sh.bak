#!/usr/bin/env bash
cd "$HOME/Desktop/tau_crystal/tau_crystal" || exit 1
set +H; set -euo pipefail; umask 022; export LC_ALL=C LANG=C

json_val(){ grep -Eo "\"$1\"[[:space:]]*:[[:space:]]*[0-9.eE+-]+" tau_crystal/data/pdg/constants.json | awk -F: "{print \$2}" | head -1; }

check_thetaW(){
  [ -f obstruction_card/out/thetaW.csv ] || { echo "θ_W file missing" >&2; return 1; }
  [ -f tau_crystal/data/pdg/constants.json ] || { echo "PDG constants missing" >&2; return 1; }
  local ref tol meas diff
  ref=$(json_val thetaW); tol=$(json_val thetaW_tol)
  meas=$(head -1 obstruction_card/out/thetaW.csv | tr -d "\r" | awk -F, "{print \$1+0}")
  diff=$(awk -v a="$meas" -v b="$ref" "BEGIN{d=a-b;if(d<0)d=-d;den=(a+b)/2;if(den==0)den=1;print d/den;}")
  if awk -v d="$diff" -v t="$tol" "BEGIN{exit(d>t)}"; then printf "θ_W   meas=%.6f  pdg=%.6f  Δ=%.3e  OK\n" "$meas" "$ref" "$diff"; else printf "θ_W   meas=%.6f  pdg=%.6f  Δ=%.3e  FAIL\n" "$meas" "$ref" "$diff"; return 1; fi
}

check_alphaEM(){
  [ -f obstruction_card/out/alpha_EM.csv ] || { echo "α_EM file missing" >&2; return 1; }
  [ -f tau_crystal/data/pdg/constants.json ] || { echo "PDG constants missing" >&2; return 1; }
  local pdg tol
  pdg=$(json_val alphaEM); tol=$(json_val alphaEM_tol)
  awk -v pdg="$pdg" -v tol="$tol" 'FNR==1{meas=$1} END{delta=(meas-pdg)/pdg; ok=((delta<0?-delta:delta)<tol); printf "α_EM  meas=%.12f  pdg=%.12f  Δ=%.3e  %s\n", meas, pdg, delta, (ok?"OK":"FAIL"); exit(!ok)}' obstruction_card/out/alpha_EM.csv /dev/null
}

check_GF(){
  [ -f obstruction_card/out/G_F.csv ] || { echo "G_F file missing" >&2; return 1; }
  [ -f tau_crystal/data/pdg/constants.json ] || { echo "PDG constants missing" >&2; return 1; }
  local pdg tol
  pdg=$(json_val G_F); tol=$(json_val G_F_tol)
  awk -v pdg="$pdg" -v tol="$tol" 'FNR==1{meas=$1} END{delta=(meas-pdg)/pdg; ok=((delta<0?-delta:delta)<tol); printf "G_F   meas=%.12e  pdg=%.12e  Δ=%.3e  %s\n", meas, pdg, delta, (ok?"OK":"FAIL"); exit(!ok)}' obstruction_card/out/G_F.csv /dev/null
}

check_mZ(){
  [ -f obstruction_card/out/m_Z.csv ] || { echo "m_Z file missing" >&2; return 1; }
  [ -f tau_crystal/data/pdg/constants.json ] || { echo "PDG constants missing" >&2; return 1; }
  local pdg tol
  pdg=$(json_val m_Z); tol=$(json_val m_Z_tol)
  awk -v pdg="$pdg" -v tol="$tol" 'FNR==1{meas=$1} END{delta=(meas-pdg)/pdg; ok=((delta<0?-delta:delta)<tol); printf "m_Z   meas=%.8f  pdg=%.8f  Δ=%.3e  %s\n", meas, pdg, delta, (ok?"OK":"FAIL"); exit(!ok)}' obstruction_card/out/m_Z.csv /dev/null
}


check_yukawa(){
  [ -f obstruction_card/out/singular_values_M.csv ] || { echo "singular_values_M.csv missing" >&2; return 1; }
  [ -f tau_crystal/data/pdg/constants.json ] || { echo "PDG constants missing" >&2; return 1; }
  v_ref=$(json_val v); [ -n "$v_ref" ] || v_ref=246.21965
  line=$(head -1 obstruction_card/out/singular_values_M.csv | tr -d "\r")
  f1=$(printf %s "$line" | cut -d, -f1); f2=$(printf %s "$line" | cut -d, -f2); f3=$(printf %s "$line" | cut -d, -f3)
  m1=$(awk -v s="$f1" -v v="$v_ref" "BEGIN{printf \"%.9f\", (s+0)*v}")
  m2=$(awk -v s="$f2" -v v="$v_ref" "BEGIN{printf \"%.9f\", (s+0)*v}")
  m3=$(awk -v s="$f3" -v v="$v_ref" "BEGIN{printf \"%.9f\", (s+0)*v}")
  echo "mass spectrum from M (σ·v):"
  printf "  m[1]=%.9f  (σ=%s)\n" "$m1" "$f1"
  printf "  m[2]=%.9f  (σ=%s)\n" "$m2" "$f2"
  printf "  m[3]=%.9f  (σ=%s)\n" "$m3" "$f3"
  fail=0
  cmp_pin(){ ref="$1"; tol="$2"; idx="$3"; label="$4"; [ -n "$ref" ] || return 0;
    case "$idx" in 1) mi="$m1";; 2) mi="$m2";; 3) mi="$m3";; *) mi="";; esac
    [ -n "$mi" ] || { echo "$label idx out of range" >&2; fail=1; return 0; }
    d=$(awk -v m="$mi" -v r="$ref" "BEGIN{d=m-r; if(d<0)d=-d; den=(m+r)/2; if(den==0)den=1; printf \"%.3e\", d/den}")
    awk -v dd="$d" -v tt="$tol" "BEGIN{exit(dd>tt)}" && ok=OK || ok=FAIL
    printf "%s  m=%.6f  ref=%.6f  Δ=%.3e  %s\n" "$label" "$mi" "$ref" "$d" "$ok"
    [ "$ok" = OK ] || fail=1
  }
  mt_ref=$(json_val m_t || true);   mt_tol=$(json_val m_t_tol || true);   mt_idx=$(json_val m_t_idx || true)
  mTau_ref=$(json_val m_tau || true); mTau_tol=$(json_val m_tau_tol || true); mTau_idx=$(json_val m_tau_idx || true)
  cmp_pin "$mt_ref" "$mt_tol" "$mt_idx"  "top (t)"
  cmp_pin "$mTau_ref" "$mTau_tol" "$mTau_idx" "tau (τ)"
  [ "$fail" -eq 0 ]
}
main_check_pdg(){ :; }
[ "${BASH_SOURCE[0]}" = "$0" ] && main_check_pdg || true

# --- verbose, printable driver (appended) ---
main_check_pdg(){
  local fail=0

  echo "== PDG scalar checks =="
  type check_thetaW >/dev/null 2>&1 && check_thetaW || fail=1
  type check_alphaEM >/dev/null 2>&1 && check_alphaEM || fail=1
  type check_GF >/dev/null 2>&1 && check_GF || fail=1
  type check_mZ >/dev/null 2>&1 && check_mZ || fail=1

  echo "== CKM / PMNS checks =="
  type check_CKM_PMNS >/dev/null 2>&1 && check_CKM_PMNS || fail=1

  echo "== Yukawa spectrum from singular_values_M.csv (σ·v) =="
  if type check_yukawa >/dev/null 2>&1; then
    check_yukawa || true
  else
    # Minimal readout if helper not present
    if [ -s obstruction_card/out/singular_values_M.csv ]; then
      v_ref=$(sed -n 's/.*"v"[[:space:]]*:[[:space:]]*\([0-9.eE+-]*\).*/\1/p' tau_crystal/data/pdg/constants.json | head -1)
      [ -n "$v_ref" ] || v_ref=246.21965
      IFS=, read -r s1 s2 s3 _ < obstruction_card/out/singular_values_M.csv || true
      for idx in 1 2 3; do
        sv=$(eval "printf '%s' \"\$s$idx\"")
        [ -n "$sv" ] || continue
        awk -v i="$idx" -v sv="$sv" -v v="$v_ref" 'BEGIN{m=sv*v; printf("  m[%d]=%.9f  (σ=%.9e)\n", i-1, m, sv)+0}' </dev/null
      done
    else
      echo "  (no singular_values_M.csv present)"
    fi
  fi

  if [ "$fail" -eq 0 ]; then
    echo "PDG gate: PASS"
    return 0
  else
    echo "PDG gate: FAIL"
    return 1
  fi
}

# ensure this file prints when invoked directly
[ "${BASH_SOURCE[0]}" = "$0" ] && main_check_pdg || true

check_yukawa(){
  # read v and optional pins
  local v_ref mt_ref mt_tol mt_idx tau_ref tau_tol tau_idx
  v_ref=$(sed -n 's/.*"v"[[:space:]]*:[[:space:]]*\([0-9.eE+-]*\).*/\1/p' tau_crystal/data/pdg/constants.json | head -1)
  [ -n "${v_ref:-}" ] || v_ref=246.21965
  mt_ref=$(sed -n 's/.*"m_t"[[:space:]]*":[[:space:]]*\([0-9.eE+-]*\).*/\1/p' tau_crystal/data/pdg/constants.json | head -1)
  mt_tol=$(sed -n 's/.*"m_t_tol"[[:space:]]*":[[:space:]]*\([0-9.eE+-]*\).*/\1/p' tau_crystal/data/pdg/constants.json | head -1)
  mt_idx=$(sed -n 's/.*"m_t_idx"[[:space:]]*":[[:space:]]*\([0-9+-]*\).*/\1/p' tau_crystal/data/pdg/constants.json | head -1)
  tau_ref=$(sed -n 's/.*"m_tau"[[:space:]]*":[[:space:]]*\([0-9.eE+-]*\).*/\1/p' tau_crystal/data/pdg/constants.json | head -1)
  tau_tol=$(sed -n 's/.*"m_tau_tol"[[:space:]]*":[[:space:]]*\([0-9.eE+-]*\).*/\1/p' tau_crystal/data/pdg/constants.json | head -1)
  tau_idx=$(sed -n 's/.*"m_tau_idx"[[:space:]]*":[[:space:]]*\([0-9+-]*\).*/\1/p' tau_crystal/data/pdg/constants.json | head -1)

  local line; line=$(head -1 obstruction_card/out/singular_values_M.csv 2>/dev/null | tr -d '\r')
  if [ -z "$line" ]; then
    echo "mass spectrum from M (σ·v): (singular_values_M.csv missing)"; return 1
  fi

  # split CSV -> bash array "sv"
  IFS=',' read -r -a sv <<< "$line"
  local n=${#sv[@]}; [ "$n" -gt 0 ] || { echo "mass spectrum from M (σ·v): empty row"; return 1; }

  echo "mass spectrum from M (σ·v):"
  # pretty print first min(n,8)
  local i maxp; maxp=$(( n<8 ? n : 8 ))
  for ((i=0;i<maxp;i++)); do
    awk -v i="$i" -v s="${sv[$i]}" -v v="$v_ref" 'BEGIN{ m=s*v; printf("  m[%d]=%.9f  (σ=%.16e)\n", i, m, s)+0 }' </dev/null
  done

  # helper to fetch by tolerant index (accepts 0- or 1-based)
  get_by_idx(){
    local idx="$1"
    # if 1-based within bounds, map to 0-based
    if [ "$idx" -ge 1 ] && [ "$idx" -le "$n" ]; then
      echo "${sv[$((idx-1))]}"; return 0
    fi
    # else if already 0-based within bounds
    if [ "$idx" -ge 0 ] && [ "$idx" -lt "$n" ]; then
      echo "${sv[$idx]}"; return 0
    fi
    return 1
  }

  local fail=0

  # compare a pin if present
  cmp_pin(){
    local name="$1" idx="$2" ref="$3" tol="$4"
    [ -n "$ref" ] && [ -n "$tol" ] && [ -n "$idx" ] || return 0
    local s; if ! s=$(get_by_idx "$idx"); then
      echo "$name idx out of range (idx=$idx, n=$n)"; fail=1; return 0
    fi
    # m = σ * v
    local m; m=$(awk -v s="$s" -v v="$v_ref" 'BEGIN{ printf("%.9f", s*v)+0 }')
    # Δ = m - ref ; pass if |Δ| <= tol
    local d a; d=$(awk -v m="$m" -v r="$ref" 'BEGIN{ printf("%.9f", m-r)+0 }')
    a=$(awk -v x="$d" 'BEGIN{ if(x<0)x=-x; printf("%.9f", x)+0 }')
    # decision
    if awk -v x="$a" -v t="$tol" 'BEGIN{ exit(x>t) }'; then
      printf "%s  m=%.6f  ref=%.6f  Δ=%+.3e  OK\n" "$name" "$m" "$ref" "$d"
    else
      printf "%s  m=%.6f  ref=%.6f  Δ=%+.3e  OUT\n" "$name" "$m" "$ref" "$d"
      fail=1
    fi
  }

  cmp_pin "top (t)"  "$mt_idx"  "$mt_ref"  "$mt_tol"
  cmp_pin "tau (τ)"  "$tau_idx" "$tau_ref" "$tau_tol"

  [ "$fail" -eq 0 ]
}
. ci/check_yukawa.sh

main_check_pdg(){
  local fail=0
  type check_thetaW >/dev/null 2>&1 && check_thetaW || true
  type check_alphaEM >/dev/null 2>&1 && check_alphaEM || true
  type check_GF >/dev/null 2>&1 && check_GF || true
  type check_mZ >/dev/null 2>&1 && check_mZ || true
  echo "== CKM / PMNS checks =="
  type check_ckm  >/dev/null 2>&1 && check_ckm  || true
  type check_pmns >/dev/null 2>&1 && check_pmns || true
  check_yukawa || fail=1
  echo "PDG gate: " $([ "$fail" -eq 0 ] && echo "PASS" || echo "FAIL")
}
[ "${BASH_SOURCE[0]}" = "$0" ] && main_check_pdg || true

main_check_pdg(){
  local fail=0
  echo "== PDG scalar checks =="
  type check_thetaW >/dev/null 2>&1 && check_thetaW || true
  type check_alphaEM >/dev/null 2>&1 && check_alphaEM || true
  type check_GF >/dev/null 2>&1 && check_GF || true
  type check_mZ >/dev/null 2>&1 && check_mZ || true

  echo "== CKM / PMNS checks =="
  type check_ckm  >/dev/null 2>&1 && check_ckm  || true
  type check_pmns >/dev/null 2>&1 && check_pmns || true

  check_yukawa || fail=1
  echo "PDG gate: " $([ "$fail" -eq 0 ] && echo "PASS" || echo "FAIL")
}
[ "${BASH_SOURCE[0]}" = "$0" ] && main_check_pdg || true
