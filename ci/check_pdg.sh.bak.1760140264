#!/usr/bin/env bash
cd "$HOME/Desktop/tau_crystal/tau_crystal" || exit 1
set +H; set -euo pipefail; umask 022; export LC_ALL=C LANG=C

json_val(){ grep -Eo "\"$1\"[[:space:]]*:[[:space:]]*[0-9.eE+-]+" tau_crystal/data/pdg/constants.json | awk -F: "{print \$2}" | head -1; }

check_thetaW(){
  [ -f obstruction_card/out/thetaW.csv ] || { echo "θ_W file missing" >&2; return 1; }
  [ -f tau_crystal/data/pdg/constants.json ] || { echo "PDG constants missing" >&2; return 1; }
  local ref tol meas diff
  ref=$(json_val thetaW); tol=$(json_val thetaW_tol)
  meas=$(head -1 obstruction_card/out/thetaW.csv | tr -d "\r" | awk -F, "{print \$1+0}")
  diff=$(awk -v a="$meas" -v b="$ref" "BEGIN{d=a-b;if(d<0)d=-d;den=(a+b)/2;if(den==0)den=1;print d/den;}")
  if awk -v d="$diff" -v t="$tol" "BEGIN{exit(d>t)}"; then printf "θ_W   meas=%.6f  pdg=%.6f  Δ=%.3e  OK\n" "$meas" "$ref" "$diff"; else printf "θ_W   meas=%.6f  pdg=%.6f  Δ=%.3e  FAIL\n" "$meas" "$ref" "$diff"; return 1; fi
}

check_alphaEM(){
  [ -f obstruction_card/out/alpha_EM.csv ] || { echo "α_EM file missing" >&2; return 1; }
  [ -f tau_crystal/data/pdg/constants.json ] || { echo "PDG constants missing" >&2; return 1; }
  local pdg tol
  pdg=$(json_val alphaEM); tol=$(json_val alphaEM_tol)
  awk -v pdg="$pdg" -v tol="$tol" 'FNR==1{meas=$1} END{delta=(meas-pdg)/pdg; ok=((delta<0?-delta:delta)<tol); printf "α_EM  meas=%.12f  pdg=%.12f  Δ=%.3e  %s\n", meas, pdg, delta, (ok?"OK":"FAIL"); exit(!ok)}' obstruction_card/out/alpha_EM.csv /dev/null
}

check_GF(){
  [ -f obstruction_card/out/G_F.csv ] || { echo "G_F file missing" >&2; return 1; }
  [ -f tau_crystal/data/pdg/constants.json ] || { echo "PDG constants missing" >&2; return 1; }
  local pdg tol
  pdg=$(json_val G_F); tol=$(json_val G_F_tol)
  awk -v pdg="$pdg" -v tol="$tol" 'FNR==1{meas=$1} END{delta=(meas-pdg)/pdg; ok=((delta<0?-delta:delta)<tol); printf "G_F   meas=%.12e  pdg=%.12e  Δ=%.3e  %s\n", meas, pdg, delta, (ok?"OK":"FAIL"); exit(!ok)}' obstruction_card/out/G_F.csv /dev/null
}

check_mZ(){
  [ -f obstruction_card/out/m_Z.csv ] || { echo "m_Z file missing" >&2; return 1; }
  [ -f tau_crystal/data/pdg/constants.json ] || { echo "PDG constants missing" >&2; return 1; }
  local pdg tol
  pdg=$(json_val m_Z); tol=$(json_val m_Z_tol)
  awk -v pdg="$pdg" -v tol="$tol" 'FNR==1{meas=$1} END{delta=(meas-pdg)/pdg; ok=((delta<0?-delta:delta)<tol); printf "m_Z   meas=%.8f  pdg=%.8f  Δ=%.3e  %s\n", meas, pdg, delta, (ok?"OK":"FAIL"); exit(!ok)}' obstruction_card/out/m_Z.csv /dev/null
}


check_yukawa(){
  [ -f obstruction_card/out/singular_values_M.csv ] || { echo "singular_values_M.csv missing" >&2; return 1; }
  [ -f tau_crystal/data/pdg/constants.json ] || { echo "PDG constants missing" >&2; return 1; }
  v_ref=$(json_val v); [ -n "$v_ref" ] || v_ref=246.21965
  line=$(head -1 obstruction_card/out/singular_values_M.csv | tr -d "\r")
  f1=$(printf %s "$line" | cut -d, -f1); f2=$(printf %s "$line" | cut -d, -f2); f3=$(printf %s "$line" | cut -d, -f3)
  m1=$(awk -v s="$f1" -v v="$v_ref" "BEGIN{printf \"%.9f\", (s+0)*v}")
  m2=$(awk -v s="$f2" -v v="$v_ref" "BEGIN{printf \"%.9f\", (s+0)*v}")
  m3=$(awk -v s="$f3" -v v="$v_ref" "BEGIN{printf \"%.9f\", (s+0)*v}")
  echo "mass spectrum from M (σ·v):"
  printf "  m[1]=%.9f  (σ=%s)\n" "$m1" "$f1"
  printf "  m[2]=%.9f  (σ=%s)\n" "$m2" "$f2"
  printf "  m[3]=%.9f  (σ=%s)\n" "$m3" "$f3"
  fail=0
  cmp_pin(){ ref="$1"; tol="$2"; idx="$3"; label="$4"; [ -n "$ref" ] || return 0;
    case "$idx" in 1) mi="$m1";; 2) mi="$m2";; 3) mi="$m3";; *) mi="";; esac
    [ -n "$mi" ] || { echo "$label idx out of range" >&2; fail=1; return 0; }
    d=$(awk -v m="$mi" -v r="$ref" "BEGIN{d=m-r; if(d<0)d=-d; den=(m+r)/2; if(den==0)den=1; printf \"%.3e\", d/den}")
    awk -v dd="$d" -v tt="$tol" "BEGIN{exit(dd>tt)}" && ok=OK || ok=FAIL
    printf "%s  m=%.6f  ref=%.6f  Δ=%.3e  %s\n" "$label" "$mi" "$ref" "$d" "$ok"
    [ "$ok" = OK ] || fail=1
  }
  mt_ref=$(json_val m_t || true);   mt_tol=$(json_val m_t_tol || true);   mt_idx=$(json_val m_t_idx || true)
  mTau_ref=$(json_val m_tau || true); mTau_tol=$(json_val m_tau_tol || true); mTau_idx=$(json_val m_tau_idx || true)
  cmp_pin "$mt_ref" "$mt_tol" "$mt_idx"  "top (t)"
  cmp_pin "$mTau_ref" "$mTau_tol" "$mTau_idx" "tau (τ)"
  [ "$fail" -eq 0 ]
}
main_check_pdg(){ :; }
[ "${BASH_SOURCE[0]}" = "$0" ] && main_check_pdg || true

## Fallback Yukawa print (runs only if nothing printed above)
if [ -t 1 ] || true; then
  v=$(sed -n 's/.*"v"[[:space:]]*:[[:space:]]*\([0-9.eE+-]\+\).*/\1/p' tau_crystal/data/pdg/constants.json | tail -1)
  sv=$(head -1 obstruction_card/out/singular_values_M.csv 2>/dev/null | tr -d '\r')
  if [ -n "$sv" ] && [ -n "$v" ]; then
    echo "-- Yukawa mass spectrum m_i = σ_i * v  (v=$v) --"
    awk -v v="$v" -F',' 'NR==1{for(i=1;i<=NF;i++){gsub(/^[[:space:]]+|[[:space:]]+$/,"",$i);
      sig=$i+0; m=sig*v; printf("  i=%d  σ=%s  m=%.8f\n", i, $i, m)} }' <(printf "%s\n" "$sv")
  fi
fi
