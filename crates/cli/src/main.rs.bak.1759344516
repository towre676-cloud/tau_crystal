use clap::{Parser, Subcommand, Args};
use tau_core::{Envelope, MotiveCapsule, NonZeroRational};
use std::fs;
use std::path::PathBuf;
use sha2::{Digest, Sha256};
use serde::{Serialize, Deserialize};

#[derive(Parser)]
#[command(name="tau", version, about="τ‑Crystal CLI (bootstrap)")]
struct Cli { #[command(subcommand)] cmd: Cmd }

#[derive(Subcommand)]
enum Cmd {
    #[command(name="motive")] Motive { #[command(subcommand)] sub: MotiveSub },
    #[command(name="ledger")] Ledger { #[command(subcommand)] sub: LedgerSub },
}

#[derive(Subcommand)]
enum MotiveSub {
    #[command(name="init", about="emit a minimal MOTIVE receipt")]
    Init { #[arg(long)] mu0: String, #[arg(long)] b: String },
}

#[derive(Subcommand)]
enum LedgerSub {
    #[command(name="seal", about="Merkle-seal a list of capsule JSON files")]
    Seal(SealArgs),
}

#[derive(Args, Debug, Clone)]
struct SealArgs { #[arg(required=true)] capsules: Vec<PathBuf> }

#[derive(Serialize, Deserialize, Debug, Clone)]
struct Leaf { name: String, sha256_hex: String }
#[derive(Serialize, Deserialize, Debug, Clone)]
struct Master { schema_version: &'static str, kind: &'static str, leaves: Vec<Leaf>, master_hash: String }

fn main() {
    let cli = Cli::parse();
    match cli.cmd {
        Cmd::Motive { sub } => match sub { MotiveSub::Init { mu0, b } => motive_init(&mu0, &b) },
        Cmd::Ledger { sub } => match sub { LedgerSub::Seal(args) => ledger_seal(args) },
    }
}

fn motive_init(mu0: &str, b: &str) {
    let mu0 = NonZeroRational::parse(mu0).unwrap_or_else(|e| panic!("mu0: {}", e));
    let b = NonZeroRational::parse(b).unwrap_or_else(|e| panic!("b: {}", e));
    let payload = MotiveCapsule { mu0, b };
    let env = Envelope::seal(payload);
    let json = tau_core::jcs::to_string(&env);
    print!("{}", json);
    eprintln!("{}", env.hash_hex);
}

fn ledger_seal(args: SealArgs) {
    if args.capsules.is_empty() { eprintln!("no capsules provided"); std::process::exit(2); }
    // read and hash leaves
    let mut leaves: Vec<Leaf> = args.capsules.iter().map(|p| {
        let name = p.to_string_lossy().into_owned();
        let val: serde_json::Value = serde_json::from_slice(&fs::read(p).unwrap()).unwrap();
        let bytes = tau_core::jcs::to_vec(&val);
        let hash = tau_core::sha2_256(&bytes);
        let sha256_hex = hex::encode(hash);
        Leaf { name, sha256_hex }
    }).collect();
        let name = p.to_string_lossy().into_owned();
        let val: serde_json::Value = serde_json::from_slice(&fs::read(p).unwrap()).unwrap();
        let bytes = tau_core::jcs::to_vec(&val);
        let hash = tau_core::sha2_256(&bytes);
        let sha256_hex = hex::encode(hash);
        Leaf { name, sha256_hex }
    }).collect();
        let name = p.to_string_lossy().into_owned();
        let val: serde_json::Value = serde_json::from_slice(&fs::read(p).unwrap()).unwrap();
        let bytes = tau_core::jcs::to_vec(&val);
        let mut h = Sha256::new(); h.update(&bytes); let hx = hex::encode(h.finalize());
        Leaf { name, sha256_hex: hx }
    }).collect();
    leaves.sort_by(|a,b| a.name.cmp(&b.name));
    // build merkle
    let mut layer: Vec<Vec<u8>> = leaves.iter().map(|l| hex::decode(&l.sha256_hex).unwrap()).collect();
    if layer.is_empty() { eprintln!("no leaves"); std::process::exit(3); }
    while layer.len() > 1 {
        let mut next: Vec<Vec<u8>> = Vec::new();
        let mut i = 0usize;
        while i < layer.len() {
            let a = &layer[i];
            let b = if i+1 < layer.len() { &layer[i+1] } else { &layer[i] };
            let mut h = Sha256::new(); h.update(a); h.update(b);
            next.push(h.finalize().to_vec());
            i += 2;
        }
        layer = next;
    }
    let master_hash = hex::encode(&layer[0]);
    let out = Master { schema_version: "0.1.0", kind: "MASTER", leaves, master_hash };
    println!("{}", serde_json::to_string(&out).unwrap());
    eprintln!("{}", out.master_hash);
}
